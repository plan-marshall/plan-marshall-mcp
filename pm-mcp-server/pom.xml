<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.planmarshall</groupId>
        <artifactId>plan-marshall-mcp-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>pm-mcp-server</artifactId>
    <packaging>jar</packaging>
    <name>pm-mcp-server</name>
    <description>Daemon assembly, Quarkus native binary pm-mcpd.</description>
    <properties>
        <maven.jar.plugin.automatic.module.name>de.planmarshall.mcp.server</maven.jar.plugin.automatic.module.name>
        <!-- Enabled by the integration-tests profile -->
        <skipITs>true</skipITs>
        <!-- The JUnit tags the test run leaves out: the corpus test fetches the public datasets of the model
             verification corpus and runs with the profile corpus only -->
        <pm.surefire.excludedGroups>corpus</pm.surefire.excludedGroups>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>de.cuioss</groupId>
            <artifactId>cui-java-tools</artifactId>
        </dependency>
        <!-- Quarkus -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- Quarkus Security: activates the HTTP authentication mechanism, the identity providers and the
             path policies of quarkus-vertx-http, which are inert without this extension
             (plan-marshall-documentation: doc/specification/cli-and-security/03-web-server.adoc, Authentication Seam) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <!-- MCP server, Streamable HTTP transport -->
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-http</artifactId>
        </dependency>
        <!-- PM-MCP modules assembled by the daemon -->
        <dependency>
            <groupId>de.planmarshall</groupId>
            <artifactId>pm-api</artifactId>
        </dependency>
        <dependency>
            <groupId>de.planmarshall</groupId>
            <artifactId>pm-core</artifactId>
        </dependency>
        <dependency>
            <groupId>de.planmarshall</groupId>
            <artifactId>pm-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>de.planmarshall</groupId>
            <artifactId>pm-provider-git</artifactId>
        </dependency>
        <dependency>
            <groupId>de.planmarshall</groupId>
            <artifactId>pm-provider-ci</artifactId>
        </dependency>
        <dependency>
            <groupId>de.planmarshall</groupId>
            <artifactId>pm-provider-github</artifactId>
        </dependency>
        <dependency>
            <groupId>de.planmarshall</groupId>
            <artifactId>pm-provider-gitlab</artifactId>
        </dependency>
        <!-- Local API: REST with SSE on the Unix socket -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <!-- Unit testing -->
        <dependency>
            <groupId>de.planmarshall</groupId>
            <artifactId>pm-runtime</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
            <version>${version.pm-mcp-core}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jacoco</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>de.cuioss.test</groupId>
            <artifactId>cui-test-juli-logger</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${pm.surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Netty native transport for the Unix domain socket listener: Vert.x 4.5 binds domain sockets
             only with it (plan-marshall-documentation: doc/specification/runtime-model/01-processes-and-transport.adoc, Transport
             Endpoint, which approves this dependency for the runtime). Versions come from quarkus-bom. -->
        <profile>
            <id>native-transport-macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport-native-kqueue</artifactId>
                    <classifier>osx-aarch_64</classifier>
                </dependency>
                <dependency>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport-native-kqueue</artifactId>
                    <classifier>osx-x86_64</classifier>
                </dependency>
            </dependencies>
            <!-- Native-image metadata of the kqueue transport (JNI access, the .jnilib resources), generated with
                 the GraalVM tracing agent; it cannot be on the classpath of a Linux build, which lacks the
                 kqueue classes -->
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                    </resource>
                    <resource>
                        <directory>src/main/native-macos</directory>
                    </resource>
                </resources>
            </build>
        </profile>
        <profile>
            <id>native-transport-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport-native-epoll</artifactId>
                    <classifier>linux-x86_64</classifier>
                </dependency>
                <dependency>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-transport-native-epoll</artifactId>
                    <classifier>linux-aarch_64</classifier>
                </dependency>
            </dependencies>
            <!-- Native-image metadata of the epoll transport, generated with the GraalVM tracing agent on Linux
                 (run the runner JAR under -agentlib:native-image-agent, exercise the socket, and keep the
                 io.netty.channel.epoll, io.netty.channel.unix and library resource entries, as in the macOS
                 file); kept out of a macOS build, which lacks the epoll classes -->
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                    </resource>
                    <resource>
                        <directory>src/main/native-linux</directory>
                    </resource>
                </resources>
            </build>
        </profile>
        <!-- Quarkus native build of pm-mcpd (plan-marshall-documentation: doc/specification/module-structure.adoc, Binaries) -->
        <profile>
            <id>native</id>
            <properties>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
        <!-- Runs the *IT tests (@QuarkusIntegrationTest) against the packaged application -->
        <profile>
            <id>integration-tests</id>
            <properties>
                <skipITs>false</skipITs>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <skipITs>${skipITs}</skipITs>
                            <systemPropertyVariables>
                                <!-- The root of the repository, for BuildGuardsIT -->
                                <pm.root>${maven.multiModuleProjectDirectory}</pm.root>
                                <!-- The version the guard fixtures take as the version of their parent -->
                                <pm.version>${project.version}</pm.version>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- The corpus test (PM-WORK-6): imports the sources of the model verification corpus from huggingface.co at
             their pinned commits and validates the corpus with the generated items. It runs with this profile only and
             runs nothing else: verify, -Pcoverage, -Pintegration-tests, -Psonar and the checks of a pull request leave
             the tag corpus out. Never activate this profile by default or from another profile. -->
        <profile>
            <id>corpus</id>
            <properties>
                <pm.surefire.excludedGroups />
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>corpus</groups>
                            <systemPropertyVariables>
                                <!-- The root of the repository, which holds the corpus test/model/verification -->
                                <pm.root>${maven.multiModuleProjectDirectory}</pm.root>
                                <!-- The cache root the import writes the generated items below, outside the corpus -->
                                <pm.corpus.cache>${project.build.directory}/corpus-cache</pm.corpus.cache>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
