<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Resolved from the package registry of the organisation plan-marshall (.mvn/settings.xml). It holds the
         Java release, the licence, the quality-gate recipes, the managed third-party versions, the plugin
         management, and the deployment target with the build check that guards it. -->
    <parent>
        <groupId>de.planmarshall</groupId>
        <artifactId>pm-mcp-parent</artifactId>
        <version>0.1.1</version>
        <relativePath />
    </parent>
    <artifactId>plan-marshall-mcp-parent</artifactId>
    <version>0.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>plan-marshall-mcp Parent</name>
    <description>Local MCP server that takes over plan-marshall's process logic via a
        hypermedia-driven workflow.
    </description>
    <url>https://github.com/plan-marshall/plan-marshall-mcp/</url>
    <!-- Restated: the licence URL of the parent names the parent's repository. -->
    <licenses>
        <license>
            <name>Proprietary - all rights reserved</name>
            <url>https://github.com/plan-marshall/plan-marshall-mcp/blob/main/LICENSE.md</url>
            <distribution>manual</distribution>
        </license>
    </licenses>
    <modules>
        <module>pm-mcp-server</module>
        <module>pm-e2e</module>
    </modules>
    <scm>
        <url>https://github.com/plan-marshall/plan-marshall-mcp/</url>
        <connection>
            scm:git:https://github.com/plan-marshall/plan-marshall-mcp.git
        </connection>
        <developerConnection>
            scm:git:https://github.com/plan-marshall/plan-marshall-mcp/
        </developerConnection>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <url>https://github.com/plan-marshall/plan-marshall-mcp/issues</url>
        <system>GitHub Issues</system>
    </issueManagement>

    <properties>
        <!-- The repository of this POM: the deployment target of the parent is
             https://maven.pkg.github.com/plan-marshall/${pm.repository}, and its enforcer rule fails without it. -->
        <pm.repository>plan-marshall-mcp</pm.repository>
        <!-- The modules of pm-mcp-clients (pm-api, pm-exec, pm-relay, pm-operator), resolved from the organisation
             registry: always the latest SNAPSHOT, they are never released. -->
        <version.pm-mcp-clients>0.1.0-SNAPSHOT</version.pm-mcp-clients>
        <!-- The modules of pm-mcp-core (pm-core, pm-runtime, the provider modules), resolved the same way -->
        <version.pm-mcp-core>0.1.0-SNAPSHOT</version.pm-mcp-core>
        <!-- Switches of the dependency rules that hold for some modules only (see the enforcer executions) -->
        <pm.guard.binaries-only.skip>true</pm.guard.binaries-only.skip>
        <pm.guard.no-assembly.skip>true</pm.guard.no-assembly.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- pm-mcp-server of this repository, and the modules of pm-mcp-clients and pm-mcp-core, each
                 repository by its one version property -->
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-api</artifactId>
                <version>${version.pm-mcp-clients}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-exec</artifactId>
                <version>${version.pm-mcp-clients}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-core</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-runtime</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-provider-git</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-provider-ci</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-provider-github</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-provider-gitlab</artifactId>
                <version>${version.pm-mcp-core}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-relay</artifactId>
                <version>${version.pm-mcp-clients}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-operator</artifactId>
                <version>${version.pm-mcp-clients}</version>
            </dependency>
            <!-- The built operator web app: a resource JAR carrying the SvelteKit SPA below META-INF/resources.
                 pm-mcp-server serves that tree, so the clients' SNAPSHOT must be published before this build. -->
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-web-app</artifactId>
                <version>${version.pm-mcp-clients}</version>
            </dependency>
            <dependency>
                <groupId>de.planmarshall</groupId>
                <artifactId>pm-mcp-server</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- This repository deploys nothing yet: the product is released from here later, and until
                     then even an explicit `mvn deploy` uploads nothing. The target stays the one of the
                     parent. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- The dependency rules of the two modules that reach the product through its built binaries alone
                 (PM-IMPL-1). Their controls are the fixture projects below src/guard-controls, which
                 BuildGuardsIT of pm-mcp-server builds and expects to fail. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <!-- pm-e2e: no class of pm-mcp-server. Its one dependency on the assembly is of type pom and
                         test scope, which orders the build and brings no class of it. Switched on in its POM. -->
                    <execution>
                        <id>binaries-only</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${pm.guard.binaries-only.skip}</skip>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>de.planmarshall:pm-mcp-server</exclude>
                                    </excludes>
                                    <includes>
                                        <include>de.planmarshall:pm-mcp-server:*:pom:test</include>
                                    </includes>
                                    <message>pm-e2e reaches pm-mcp-server through its built binary alone: only a test-scoped dependency of type pom, which orders the build.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                    <!-- pm-conformance: no Maven dependency on pm-mcp-server at all; it runs the built binaries of a
                         release candidate and is no part of the regular build. Switched on in its POM. -->
                    <execution>
                        <id>no-assembly</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${pm.guard.no-assembly.skip}</skip>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>de.planmarshall:pm-mcp-server</exclude>
                                    </excludes>
                                    <message>pm-conformance has no Maven dependency on pm-mcp-server.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- The behavioural conformance harness (PM-TEST-6) is a module of the build with this profile only:
             verify, -Pintegration-tests, -Pcoverage and the CI builds never name it, so none of them builds or
             runs pm-conformance. Never add the module to the modules above, and never activate this profile by
             default or from another profile. -->
        <profile>
            <id>conformance</id>
            <modules>
                <module>pm-conformance</module>
            </modules>
        </profile>
        <profile>
            <id>coverage</id>
            <properties>
                <!-- Adds the report of the daemon assembly, which the SonarCloud analysis of the root reads -->
                <sonar.coverage.jacoco.xmlReportPaths>
                    ${project.build.directory}/site/jacoco/jacoco.xml,
                    pm-mcp-server/target/site/jacoco/jacoco.xml,
                    ../target/site/jacoco/jacoco.xml
                </sonar.coverage.jacoco.xmlReportPaths>
            </properties>
        </profile>
    </profiles>
</project>
